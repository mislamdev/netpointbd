# Net Point BD — environment variables
# Copy to `.env` and fill in real values. The `.env` file is gitignored.

# Required in production. Long random string used to sign admin session cookies.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=replace-me-with-48-chars-of-randomness-12345

# Optional. Path prefix for assets when serving from a sub-path.
# Leave empty unless you serve the site from something like /netpointbd.
NEXT_PUBLIC_BASE_PATH=

# Optional. Defaults to "json" (file-based storage in /data).
# Set to "vercel" only after wiring up lib/db.vercel.ts to Vercel KV / Turso.
# Vercel serverless filesystems are ephemeral — the JSON path will not persist there.
STORAGE_DRIVER=json

# Standard Node
NODE_ENV=development
PORT=3000
